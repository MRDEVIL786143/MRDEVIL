# ─────────────────────────────────────────────────────────────────────────────
# MR DEVIL VIDEO DOWNLOADER — Environment Variables
# Copy this to your Railway service → "Variables" tab (or a local .env file).
#
# THE RAILWAY PROBLEM: Railway gives your app a DATACENTER IP. YouTube
# ("Sign in to confirm you're not a bot"), TikTok (captcha) and Instagram
# (login wall) block datacenter IPs. The fix is #1 + #2 below — they make
# requests leave through residential IPs with real session cookies.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
PORT=3001

# ── Stats & Review Persistence ────────────────────────────────────────────────
# Download counts / reviews live here. On Railway, attach a Volume and set
# DATA_DIR to the mount path (e.g. /data). Without it, stats reset on redeploys.
DATA_DIR=./data

# ══════════════════════════════════════════════════════════════════════════════
# 1. GLOBAL PROXY POOL (THE fix for server-IP blocks — works on ALL platforms)
# ══════════════════════════════════════════════════════════════════════════════
# Comma-separated HTTP/SOCKS proxies. Residential or mobile proxies recommended.
# The pool rotates them per request and auto-cools-down failing ones.
#   Webshare:   https://www.webshare.io  (10 free proxies)
#   IPRoyal:    https://iproyal.com      (pay-as-you-go residential)
#   Bright Data: https://brightdata.com  (enterprise rotating gateway)
#
# Examples:
#   PROXIES=http://user:pass@p.webshare.io:80
#   PROXIES=http://user:pass@geo.iproyal.com:12321,http://user2:pass2@geo.iproyal.com:12321
#   PROXIES=socks5://user:pass@proxy-host:1080
PROXIES=

# Single-proxy alias (merged into the pool)
PROXY_URL=

# How long a failing proxy is benched before it gets retried (ms)
PROXY_COOLDOWN_MS=300000

# ══════════════════════════════════════════════════════════════════════════════
# 2. YOUTUBE COOKIES (breaks the "Sign in to confirm you're not a bot" wall)
# ══════════════════════════════════════════════════════════════════════════════
# Easiest on Railway — host a cookies.txt anywhere private and paste the URL:
#   1. Log into YouTube in your browser
#   2. Export cookies with the "Get cookies.txt LOCALLY" browser extension
#   3. Upload cookies.txt to a private GitHub gist / S3 / any URL
#   4. Set the URL below (re-fetched every 6 h so you can rotate it)
# YOUTUBE_COOKIES_URL=https://gist.githubusercontent.com/you/xxx/raw/cookies.txt
YOUTUBE_COOKIES_URL=

# Or paste the cookie header directly (F12 → Network → any request → Cookie):
# YOUTUBE_COOKIES=PREF=xxx; SID=xxx; HSID=xxx; SSID=xxx; SAPISID=xxx; ...
YOUTUBE_COOKIES=

# Or bake a cookies.txt file into your repo / volume:
# YOUTUBE_COOKIES_FILE=/data/youtube-cookies.txt
YOUTUBE_COOKIES_FILE=

# The same three options exist per platform:
#   TIKTOK_COOKIES / TIKTOK_COOKIES_URL / TIKTOK_COOKIES_FILE
#   FACEBOOK_COOKIES / FACEBOOK_COOKIES_URL / FACEBOOK_COOKIES_FILE
#   TWITTER_COOKIES / TWITTER_COOKIES_URL / TWITTER_COOKIES_FILE
#   REDDIT_COOKIES / REDDIT_COOKIES_URL / REDDIT_COOKIES_FILE
# How often URL-based cookies are re-downloaded (hours)
COOKIES_REFRESH_HOURS=6

# ══════════════════════════════════════════════════════════════════════════════
# 3. FALLBACK EXTRACTOR SERVICES (optional safety nets)
# ══════════════════════════════════════════════════════════════════════════════
# Cobalt API — free/open-source extractor, works for YouTube/TikTok/IG/etc.
# Self-host: https://github.com/imputnet/cobalt (or use any public instance URL)
COBALT_API_URL=

# RapidAPI TikTok scraper — last-resort TikTok provider (500 req/month free)
# https://rapidapi.com/tikwm-tikwm-default/api/tiktok-scraper7
RAPIDAPI_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# 4. INSTAGRAM (its own cookie system — session cookie required even for
#    public posts when requested from datacenter IPs)
# ══════════════════════════════════════════════════════════════════════════════
# Option 1: just the sessionid value (easiest)
INSTAGRAM_SESSION_ID=
# Option 2: full cookie string: INSTAGRAM_COOKIES=sessionid=xxx; csrftoken=yyy; ds_user_id=zzz
# Option 3: path to a Netscape cookies.txt: INSTAGRAM_COOKIES_FILE=/data/ig.txt

# ══════════════════════════════════════════════════════════════════════════════
# 5. SCALE TUNING (defaults are fine up to hundreds of concurrent users)
# ══════════════════════════════════════════════════════════════════════════════
# How many yt-dlp processes may run at once (info + URL resolution)
MAX_PARALLEL_EXTRACTIONS=6
# How many heavy temp-file downloads (MP3 conversion / video merging) at once.
# Regular video downloads STREAM — they don't use temp disk and don't count here.
MAX_PARALLEL_DOWNLOADS=4
# Force IPv4 for yt-dlp (fixes broken IPv6 egress on some hosts). 0 = off
YTDLP_IPV4=1

# ── Advanced / optional ───────────────────────────────────────────────────────
# Custom yt-dlp binary path (auto-detected otherwise)
YTDLP_PATH=
# Secret for signed streaming URLs. Random per-boot when unset (safe default).
# Set it only if you run multiple replicas behind one domain.
STREAM_SECRET=
# Stream-link lifetime in minutes (browser starts the download within this window)
STREAM_TOKEN_TTL_MIN=30
